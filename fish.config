# aliases
alias gc="git commit -m"
alias gs="git status"
alias fs="foreman start"
alias rs="rails server"
alias fds="make run"
alias p="pnpm"

function ggpull
	set -l branch (git branch --show-current 2>/dev/null)

	if test -z "$branch"
		echo "Nenhuma branch ativa encontrada no repositório atual."
		return 1
	end

	git pull origin "$branch"
end

function ggpush
	set -l branch (git branch --show-current 2>/dev/null)

	if test -z "$branch"
		echo "Nenhuma branch ativa encontrada no repositório atual."
		return 1
	end

	git push origin "$branch"
end



# variables
export RAILS_ENV="development"
export PORT='3000'
export EDITOR='code'
